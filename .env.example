# Copia este archivo como .env y ajusta lo que necesites.
# .env está en .gitignore: NUNCA lo subas a GitHub.

# ── Servidor de pruebas ─────────────────────────────────────────────
# Solo localhost. El bot se niega a entrar a otro servidor salvo ALLOW_REMOTE_SERVER=true.
MC_HOST=127.0.0.1
MC_PORT=25565
# Última versión que soporta mineflayer 4.39 (protocolo 775 = 26.1.x).
MC_VERSION=26.1.2
# Marca que debe tener el MOTD del servidor; el bot no entra a servidores sin ella.
SERVER_MARKER=[minecraft-agent]
ALLOW_REMOTE_SERVER=false

# ── Bot ─────────────────────────────────────────────────────────────
# 3 a 16 caracteres: letras, números o _
BOT_NAME=Agente
# debug | info | warn | error
LOG_LEVEL=info

# ── Scripts del servidor (opcional) ─────────────────────────────────
# Ruta a Java 25+. Si se deja vacío, se busca solo (incluye el Java del launcher).
JAVA_PATH=
SERVER_MEMORY=2G

# ── IA (etapa 3, todavía no se usa) ─────────────────────────────────
# ANTHROPIC_API_KEY=
# MODELO_RAPIDO=
# MODELO_PLANIFICADOR=
# MAX_STEPS=
